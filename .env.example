# .env.local for dynamic mode (skip for static)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BUCKET_NAME=assets
NEXT_PUBLIC_SITE_URL=

# --- Optional Discord notifications ---
# SECURITY NOTE: every NEXT_PUBLIC_* value is embedded in the public JS bundle.
# A Discord webhook URL grants anyone who extracts it the ability to post to
# your channel. Only set these if you accept that risk; the safer alternative
# is a Supabase Database Webhook on the contact_submissions table
# (Dashboard > Database > Webhooks), which keeps the URL server-side.

# NO LONGER READ. Visits are recorded in the site_visits table and shown in
# Admin -> Analytics; the Discord ping for a new visitor is sent by a database
# trigger reading the URL from `integration_settings` (Admin -> Analytics ->
# Notifications), deduplicated to the first visit of the day per visitor.
# Requires db/migrations/008-visitor-analytics.sql. Safe to delete this line.
NEXT_PUBLIC_VISIT_NOTIFIER_URL=

# STATIC MODE ONLY. With Supabase configured this is ignored: the contact
# notification is sent by a database trigger reading the URL from the
# admin-only `integration_settings` table (Admin -> Inbox -> Notifications).
# Anything with the NEXT_PUBLIC_ prefix is compiled into the client bundle and
# is readable by every visitor, and a Discord webhook URL is full authority to
# post in that channel. A static deployment has no server to hide it behind;
# a Supabase-backed one does, so it should use it.
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=
